# Rename this file to .env and fill in your own values.

# Center of the radar and map, usually where you are: LAT,LON in decimal degrees
CENTER_COORDS=0.0,0.0

# Optional: comma-separated callsigns or tail numbers to color orange in radar and map mode
FLAGGED_AIRCRAFT=AA123,N5000A

# Recommended: an OpenSky API client for flight paths (4,000 credits a day instead of 400 without one).
# Sign up free at https://opensky-network.org/ and create an API client on your account page.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=